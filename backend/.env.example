# ============================================================
# VisAgent - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 应用基础配置 ──────────────────────────────────
APP_NAME=VisAgent
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── 数据库配置（与 docker-compose.yml 对应）───────
# ⚠️ 安全警告：请务必修改默认密码！使用弱密码会导致安全风险
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visagent
DB_USER=visagent
# 生产环境请使用强密码，例如：DB_PASSWORD=YourStr0ng!P@ssw0rd
DB_PASSWORD=visagent

# ── Redis 配置 ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker/云环境可直接覆盖完整连接字符串；留空时由 HOST 和 PORT 组合。
REDIS_URL=

# ── MinIO 配置 ────────────────────────────────────
# ⚠️ 安全警告：请务必修改默认密码！使用弱密码会导致安全风险
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
# 生产环境请使用强密码，例如：MINIO_SECRET_KEY=YourStr0ng!MinI0P@ss
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=visagent-images
MINIO_SECURE=false

# ── JWT 认证配置 ──────────────────────────────────
JWT_SECRET_KEY=visagent-dev-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie 安全标志，生产环境需开启 HTTPS
COOKIE_SECURE=true

# ── 大模型配置（OpenAI 兼容接口）────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_MODE=real
LLM_TIMEOUT_SECONDS=60

# 嵌入模型（OpenAI-compatible embeddings 接口）
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.example.com/v1/embeddings
EMBEDDING_API_KEY=replace_me

# ── 食物识别（V1）──────────────────────────────────
# 食品识别固定使用仓库交付的 YOLO 权重，不提供虚拟模型降级。
FOOD_PROVIDER=yolo
FOOD_MODEL_PATH=../models/food/best.pt
FOOD_CLASSES_PATH=scripts/food_model/classes.yaml
FOOD_CONF_THRESHOLD=0.25
FOOD_MODEL_VERSION=food-yolo-v1

# ── LangChain 配置（可选）───────────────────────
# 启用 LangSmith 监控（可选，不需要可设为 false）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=visagent

# ── CORS 配置 ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── 训练/数据集 配置 ──────────────────────────────
# 允许访问的目录白名单（逗号分隔），用于数据集浏览、自动发现和训练路径校验
ALLOWED_TRAINING_DIRS=/tmp,/data,/home

# 文件夹检测允许访问的目录白名单
ALLOWED_DETECTION_DIRS=/tmp

# 推理服务最多缓存的模型数量
MAX_CACHED_MODELS=5
