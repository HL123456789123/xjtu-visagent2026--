# ============================================================
# VisAgent - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 应用基础配置 ──────────────────────────────────
APP_NAME=VisAgent
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── 数据库配置（与 docker-compose.yml 对应）───────
# ⚠️ 安全警告：请务必修改默认密码！使用弱密码会导致安全风险
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visagent
DB_USER=visagent
# 生产环境请使用强密码，例如：DB_PASSWORD=YourStr0ng!P@ssw0rd
DB_PASSWORD=visagent
# 可选；设置后会优先于上述 DB_* 组合。Compose 容器会提供该值。
DATABASE_URL=

# ── Redis 配置 ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# 当前 Settings 从 REDIS_HOST/REDIS_PORT 生成连接；此项仅用于 Compose 诊断，暂未被代码读取。
REDIS_URL=redis://localhost:6379/0

# ── MinIO 配置 ────────────────────────────────────
# ⚠️ 安全警告：请务必修改默认密码！使用弱密码会导致安全风险
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
# 生产环境请使用强密码，例如：MINIO_SECRET_KEY=YourStr0ng!MinI0P@ss
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=visagent-images
MINIO_SECURE=false

# ── JWT 认证配置 ──────────────────────────────────
JWT_SECRET_KEY=visagent-dev-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie 安全标志，生产环境需开启 HTTPS
COOKIE_SECURE=true

# ── V1.1 Food Provider 配置 ───────────────────────
# Mock 用于本地/容器联调；yolo 模式缺失权重时必须返回 503，不得降级为 Mock。
FOOD_PROVIDER=mock
FOOD_MODEL_PATH=/models/food/best.pt
FOOD_CLASSES_PATH=./scripts/food_model/classes.yaml
# V1.1 固定配置名；当前 Food API 的实际阈值仍由请求字段决定。
FOOD_CONF_THRESHOLD=0.25
FOOD_MODEL_REGISTRY_DIR=/models/food-registry
FOOD_MODEL_MAX_PACKAGE_BYTES=536870912

# ── V1.1 Recipe / Chat LLM 配置 ───────────────────
# fake 模式不需要真实 Key；real 模式必须填写以下全部字段，失败时返回 503。
LLM_MODE=fake
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
LLM_TIMEOUT_SECONDS=60

# ── 旧 Knowledge 模块兼容配置（非 V1.1 Recipe/Chat 配置）──
# 保留原因：knowledge_service 仍读取 Settings.OPENAI_*；不得把它用于新的 LLMGateway。
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── LangChain 配置（可选）───────────────────────
# 启用 LangSmith 监控（可选，不需要可设为 false）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=visagent

# ── CORS 配置 ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
