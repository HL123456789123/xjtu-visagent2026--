# Docker Compose local-development template. Copy to the repository-root .env
# and replace all placeholders before running Compose. This file contains no
# production secret and defaults the V1.1 integrations to Mock/Fake.
DEBUG=true

DB_NAME=visagent
DB_USER=visagent
DB_PASSWORD=replace_with_a_local_postgres_password

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_a_local_minio_password
MINIO_BUCKET=visagent-images

JWT_SECRET_KEY=replace_with_a_local_jwt_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000

FOOD_PROVIDER=mock
FOOD_MODEL_PATH=/models/food/best.pt
FOOD_CLASSES_PATH=/app/backend/scripts/food_model/classes.yaml
FOOD_CONF_THRESHOLD=0.25

LLM_MODE=fake
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_me
LLM_TIMEOUT_SECONDS=60
